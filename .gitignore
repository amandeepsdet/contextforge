# ---------------------------------------------------------------------------
# ContextForge .gitignore
# Implementation has not started yet (Milestone 1A). These entries are
# forward-looking so that no generated artifacts are accidentally committed.
# ---------------------------------------------------------------------------

# Rust / Cargo (future implementation)
/target/
**/*.rs.bk
Cargo.lock.orig

# Build & dist artifacts
/dist/
/build/
*.o
*.a
*.so
*.dll
*.dylib
*.exe

# Benchmarks: raw corpora and generated outputs should not be committed.
# Only benchmark *definitions*, *methodology*, *schemas*, *ground truth*,
# *questions*, *manifests*, and *reports* belong in git.
/benchmarks/corpora/
/benchmarks/outputs/
/benchmarks/cache/
# Raw corpus files and raw system outputs (see 02_benchmark_spec.md §5.3, §8, §22).
/benchmarks/corpus/files/
/benchmarks/corpus/raw/
/benchmarks/runs/**/raw/
/benchmarks/runs/**/outputs/
*.pdf
*.docx
*.pptx
*.xlsx
*.xls

# Python (used only for research/benchmark tooling, if any)
__pycache__/
*.py[cod]
.venv/
venv/
.env

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Logs & temp
*.log
tmp/
temp/
